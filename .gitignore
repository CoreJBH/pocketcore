# Python tooling
__pycache__/
*.pyc

# Tracked on purpose, listed so nobody "fixes" the rules above:
#   app/src/main/jniLibs/arm64-v8a/libbitcoind.so   the real bitcoind executable
#   app/src/main/assets/ipv4_country.bin            offline peer country table
#   gradle/wrapper/gradle-wrapper.jar               Gradle wrapper
